# ===============================================
# VIP CARD APP - ENVIRONMENT CONFIGURATION
# ===============================================

# 1. Telegram Bot Token (obtain from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# 2. Private Database Channel ID (e.g. -1001234567890)
# Make sure your bot is added as an ADMINISTRATOR with Post Messages permission
PRIVATE_DB_CHANNEL_ID=-1001234567890

# 3. Admin Notification & Top-Up Queue Channel ID (can be the same as DB or separate)
ADMIN_QUEUE_CHANNEL_ID=-1001234567890

# 4. Admin Telegram User IDs (comma separated integers)
ADMIN_USER_IDS=123456789,987654321

# 5. Server Port
PORT=3000

# 6. WebApp URL (used for invoice links and Telegram Mini App buttons)
WEBAPP_URL=http://localhost:3000

# 7. Admin Panel Secret Password (for web login)
ADMIN_SECRET_KEY=vipadmin2026
